{
  "meme_review_provider_id": {
    "description": "用于表情包审查和命名的 LLM Provider",
    "hint": "选择用于自动识图并生成 meme_def、description 和 tags 的 LLM Provider，留空使用默认",
    "type": "string",
    "default": "",
    "_special": "select_provider"
  },
  "review_system_prompt": {
    "description": "表情包审查 System Prompt",
    "hint": "要求视觉模型返回 should_steal、description、filename 和 tags JSON",
    "type": "string",
    "default": ""
  },
  "max_stickers": {
    "description": "最大表情包数量",
    "hint": "超过后不再自动采集新图片",
    "type": "int",
    "default": 100
  },
  "max_stickers_per_message": {
    "description": "每条消息最多使用的贴纸数量",
    "type": "int",
    "default": 1
  },
  "max_prompt_meme_defs": {
    "description": "每轮注入的 meme_def 数量上限",
    "type": "int",
    "default": 30
  },
  "max_prompt_tags": {
    "description": "每轮注入的 tag 数量上限",
    "type": "int",
    "default": 30
  },
  "enable_auto_steal": {
    "description": "启用自动偷图",
    "type": "bool",
    "default": true
  },
  "cleanup_interval_hours": {
    "description": "自动清理间隔（小时）",
    "type": "int",
    "default": 1
  },
  "cleanup_count": {
    "description": "每次清理数量",
    "type": "int",
    "default": 5
  },
  "enable_auto_cleanup": {
    "description": "启用自动清理",
    "type": "bool",
    "default": true
  },
  "min_stickers_to_keep": {
    "description": "最小保留表情包数量",
    "type": "int",
    "default": 0
  },
  "steal_all_images": {
    "description": "偷取所有图片",
    "type": "bool",
    "default": false
  },
  "only_store_emojis": {
    "description": "仅偷取商城表情",
    "type": "bool",
    "default": false
  }
}
